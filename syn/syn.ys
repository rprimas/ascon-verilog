# read design 
plugin -i slang
read_slang --single-unit --top ascon_core --dir-prefix rtl -F./file_list.txt

# generic synthesis
synth -top ascon_core

# mapping to simple_cells.lib
dfflibmap -liberty syn/simple_cells.lib
abc -liberty syn/simple_cells.lib
clean

# write synthesized design
write_verilog syn.v

stat -liberty syn/simple_cells.lib
